# ==============================================================
# Mini Analytics - Environment Configuration Example
# Copy this file to .env and customize secrets before deployment.
# ==============================================================

# Flask Session & Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# Keyed HMAC Secret for IP Pseudonymization (NEVER commit raw secrets)
IP_HMAC_SECRET=replace_with_a_distinct_random_64_character_hex_secret
IP_HMAC_KEY_VERSION=v1

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_strong_password_in_production

# Database path (Use persistent storage volume on Botkeep or cloud hosts)
DB_PATH=data/mini_analytics.db

# Reporting Display Timezone (Default: Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata

# Data Retention Period (Days to retain raw events before purge)
RETENTION_DAYS=90

# Reverse Proxy Trust Configuration:
# Leave empty or set to 'none' if server directly receives traffic.
# If behind a known reverse proxy (e.g. Nginx, Cloudflare, Botkeep edge proxy),
# specify comma-separated trusted IP addresses or CIDR blocks (e.g., "127.0.0.1,10.0.0.0/8").
TRUSTED_PROXIES=

# Cookie Security (set to 'true' in production HTTPS environments)
COOKIE_SECURE=false

# Port allocated by hosting environment (Botkeep sets PORT)
PORT=5000
HOST=0.0.0.0
